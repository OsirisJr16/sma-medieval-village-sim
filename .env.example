# =============================================================================
# Medieval Village Simulation - Example environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values for your local setup:
#     cp .env.example .env
#
# All variables are optional; `config/settings.py` provides sensible defaults.
# Variables are prefixed with `MVS_` (Medieval Village Simulation) to avoid
# collisions with other tools in the environment.
# -----------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
MVS_ENV=development            # development | testing | production
MVS_DEBUG=true
MVS_RANDOM_SEED=42             # Set for reproducible runs; leave empty for random.

# --- Logging -----------------------------------------------------------------
MVS_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
MVS_LOG_TO_FILE=false
MVS_LOG_DIR=logs

# --- World / grid ------------------------------------------------------------
MVS_GRID_WIDTH=100
MVS_GRID_HEIGHT=100
MVS_GRID_TORUS=false

# --- Simulation --------------------------------------------------------------
MVS_MAX_STEPS=0                # 0 = run until stopped.
MVS_INITIAL_VILLAGERS=20

# --- Rendering (Pygame) ------------------------------------------------------
MVS_RENDER_ENABLED=true
MVS_WINDOW_WIDTH=1280
MVS_WINDOW_HEIGHT=720
MVS_TARGET_FPS=60
MVS_TILE_SIZE=16

# --- Persistence -------------------------------------------------------------
MVS_SAVE_DIR=saves
