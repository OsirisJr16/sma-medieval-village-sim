# =============================================================================
# Medieval Village Simulation - Git ignore rules
# =============================================================================

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Byte-compiled / optimized / caches --------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution / packaging ------------------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# --- Test & type-checker caches ----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- IDE / editor ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Claude Code (keep shared settings.json; ignore local/temp files) --------
.claude/settings.local.json
.claude/*.tmp.*

# --- Environment & secrets ---------------------------------------------------
.env
.env.local
*.local

# --- Simulation artifacts (generated at runtime) -----------------------------
saves/
logs/
*.log
mde/generated/*
!mde/generated/.gitkeep

# --- Jupyter (optional analysis notebooks) -----------------------------------
.ipynb_checkpoints/

# macOS archive junk
__MACOSX/

# Local notes (not tracked)
AGENTS_CAPABILITIES.md
